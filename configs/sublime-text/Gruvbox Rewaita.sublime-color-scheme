{
  // Rewaita's Gruvbox palette as in configs/wezterm/wezterm.lua, but on
  // Gruvbox's lighter soft background, #32302f, rather than #282828. Plain
  // text is a near-white cream, brighter than any Gruvbox shade, because the
  // window blur fades it; the colours are Gruvbox's bright set.
  // The Adaptive UI theme takes its chrome colours from this background.
  "name": "Gruvbox Rewaita",
  "author": "sorrtory",
  "variables": {
    "bg0_h": "#1d2021",
    "bg0": "#32302f",
    "bg1": "#45403d",
    "bg2": "#504945",
    "bg3": "#665c54",
    "bg4": "#7c6f64",
    "gray": "#928374",
    "fg0": "#fffaeb",
    "fg1": "#ebdbb2",
    "fg4": "#a89984",
    "red": "#fb4934",
    "green": "#b8bb26",
    "yellow": "#fabd2f",
    "blue": "#83a598",
    "purple": "#d3869b",
    "aqua": "#8ec07c",
    "orange": "#fe8019"
  },
  "globals": {
    "background": "var(bg0)",
    "foreground": "var(fg0)",
    "caret": "var(orange)",
    "invisibles": "var(bg3)",
    "line_highlight": "var(bg1)",
    "selection": "var(bg2)",
    "selection_border": "var(bg2)",
    "inactive_selection": "var(bg1)",
    "misspelling": "var(red)",
    "gutter": "var(bg0)",
    "gutter_foreground": "var(bg4)",
    "gutter_foreground_highlight": "var(fg4)",
    "guide": "var(bg1)",
    "active_guide": "var(bg3)",
    "stack_guide": "var(bg2)",
    "find_highlight": "var(yellow)",
    "find_highlight_foreground": "var(bg0)",
    "highlight": "var(yellow)",
    "brackets_options": "underline",
    "brackets_foreground": "var(orange)",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "var(orange)",
    "tags_options": "stippled_underline",
    "tags_foreground": "var(orange)",
    "accent": "var(orange)",
    "shadow": "color(var(bg0_h) alpha(0.5))",
    "line_diff_added": "var(green)",
    "line_diff_modified": "var(orange)",
    "line_diff_deleted": "var(red)"
  },
  "rules": [
    { "scope": "comment, punctuation.definition.comment", "foreground": "var(gray)", "font_style": "italic" },
    { "scope": "string", "foreground": "var(green)" },
    { "scope": "constant.character.escape, string.regexp", "foreground": "var(orange)" },
    { "scope": "constant.numeric, constant.language, constant.character, constant.other", "foreground": "var(purple)" },
    { "scope": "keyword, storage.modifier, keyword.control", "foreground": "var(red)" },
    { "scope": "keyword.operator", "foreground": "var(fg0)" },
    { "scope": "keyword.control.import, keyword.control.directive, meta.preprocessor", "foreground": "var(aqua)" },
    { "scope": "storage.type, entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class", "foreground": "var(yellow)" },
    { "scope": "entity.name.function, support.function, variable.function", "foreground": "var(green)", "font_style": "bold" },
    { "scope": "variable.parameter", "foreground": "var(blue)" },
    { "scope": "variable.language, support.constant", "foreground": "var(orange)" },
    { "scope": "variable.other.member, meta.property-name, support.type.property-name", "foreground": "var(blue)" },
    { "scope": "entity.name.tag", "foreground": "var(aqua)" },
    { "scope": "entity.other.attribute-name", "foreground": "var(yellow)" },
    { "scope": "punctuation.definition.tag", "foreground": "var(blue)" },
    { "scope": "entity.name.section, markup.heading", "foreground": "var(green)", "font_style": "bold" },
    { "scope": "markup.bold", "font_style": "bold" },
    { "scope": "markup.italic", "font_style": "italic" },
    { "scope": "markup.underline.link, markup.link", "foreground": "var(blue)" },
    { "scope": "markup.raw", "foreground": "var(aqua)" },
    { "scope": "markup.quote", "foreground": "var(gray)", "font_style": "italic" },
    { "scope": "markup.list punctuation.definition.list_item", "foreground": "var(orange)" },
    { "scope": "markup.inserted", "foreground": "var(green)" },
    { "scope": "markup.deleted", "foreground": "var(red)" },
    { "scope": "markup.changed", "foreground": "var(orange)" },
    { "scope": "invalid", "foreground": "var(fg0)", "background": "var(red)" },
    { "scope": "invalid.deprecated", "foreground": "var(bg0)", "background": "var(orange)" }
  ]
}
